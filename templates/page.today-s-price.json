      "settings": {
        "custom_liquid": "{% comment %}\n================================================================================\n  PREMIUM \"TODAY'S SEAFOOD PRICES\" PAGE\n  Theme: Ocean Inspired (Mobile-First, Luxury, High Performance)\n================================================================================\n{% endcomment %}\n\n{% comment %} CONFIGURATION {% endcomment %}\n{% assign SEE_MORE_URL = \"https://truseafish.com/collections/limited-catch\" %}\n{% assign SEAFOOD_COLLECTION_HANDLE = \"all\" %} {% comment %} Change to a specific collection handle if desired {% endcomment %}\n\n<style>\n  /* Base Variables & Reset */\n  :root {\n    --bg-color: #0E2541;\n    --accent-white: #FFFFFF;\n    --accent-gold: #F9C74F;\n    --accent-blue: #00B4D8;\n    --glass-white: rgba(255, 255, 255, 0.08);\n    --glass-border: rgba(255, 255, 255, 0.12);\n    --glass-sticky: rgba(14, 37, 65, 0.85);\n    --font-premium: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  .ts-market-body {\n    background-color: var(--bg-color);\n    color: var(--accent-white);\n    font-family: var(--font-premium);\n    margin: 0;\n    padding: 0;\n    min-height: 100vh;\n    position: relative;\n    overflow-x: hidden;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  /* --- Premium Lightweight Ocean Background --- */\n  .ts-ocean-bg {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 1;\n    pointer-events: none;\n    background: linear-gradient(180deg, #133054 0%, #0E2541 100%);\n    animation: oceanGlow 12s ease-in-out infinite alternate;\n  }\n\n  /* Light Rays */\n  .ts-ocean-bg::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 60%;\n    background: radial-gradient(circle at 50% -20%, rgba(0, 180, 216, 0.15) 0%, transparent 70%);\n    filter: blur(20px);\n  }\n\n  /* Animated Bubbles */\n  .ts-bubble {\n    position: absolute;\n    bottom: -20px;\n    background: rgba(255, 255, 255, 0.15);\n    border-radius: 50%;\n    animation: floatingBubbles 8s infinite linear;\n  }\n  .ts-bubble:nth-child(1) { left: 15%; width: 6px; height: 6px; animation-duration: 9s; animation-delay: 1s; }\n  .ts-bubble:nth-child(2) { left: 45%; width: 4px; height: 4px; animation-duration: 7s; animation-delay: 3s; }\n  .ts-bubble:nth-child(3) { left: 75%; width: 5px; height: 5px; animation-duration: 11s; animation-delay: 0s; }\n\n  /* Subtle Fish Silhouettes */\n  .ts-fish-silhouette {\n    position: absolute;\n    top: 35%;\n    left: -100px;\n    width: 40px;\n    height: 12px;\n    background: rgba(0, 180, 216, 0.04);\n    clip-path: polygon(0% 50%, 20% 20%, 75% 20%, 100% 50%, 75% 80%, 20% 80%, 90% 50%);\n    animation: fishSwim 25s infinite linear;\n  }\n  .ts-fish-silhouette:nth-child(5) { top: 65%; animation-duration: 32s; animation-delay: 8s; }\n\n  /* Subtle Crab Animation */\n  .ts-crab {\n    position: fixed;\n    bottom: 10px;\n    right: 15px;\n    width: 16px;\n    height: 10px;\n    background: rgba(249, 199, 79, 0.15);\n    border-radius: 6px 6px 3px 3px;\n    animation: crabScuttle 15s infinite ease-in-out;\n    z-index: 2;\n  }\n\n  /* Keyframes */\n  @keyframes oceanGlow { 0% { opacity: 0.9; } 100% { opacity: 1; } }\n  @keyframes floatingBubbles {\n    0% { transform: translateY(0) scale(1); opacity: 0; }\n    10% { opacity: 0.4; }\n    90% { opacity: 0.4; }\n    100% { transform: translateY(-105vh) scale(1.2); opacity: 0; }\n  }\n  @keyframes fishSwim {\n    0% { transform: translateX(-10vw) scaleX(1); }\n    49% { transform: translateX(110vw) scaleX(1); }\n    50% { transform: translateX(110vw) scaleX(-1); }\n    99% { transform: translateX(-10vw) scaleX(-1); }\n    100% { transform: translateX(-10vw) scaleX(1); }\n  }\n  @keyframes crabScuttle {\n    0%, 100% { transform: translateX(0); }\n    45% { transform: translateX(-30px); }\n    50% { transform: translateX(-30px) scaleX(-1); }\n    95% { transform: translateX(0) scaleX(-1); }\n  }\n\n  /* --- Main Interface Container --- */\n  .ts-market-container {\n    position: relative;\n    z-index: 3;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 16px;\n    box-sizing: border-box;\n    opacity: 0;\n    animation: fadeInPage 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n  }\n  @keyframes fadeInPage { to { opacity: 1; } }\n\n  /* Header Styles */\n  .ts-header {\n    text-align: center;\n    padding: 24px 0 16px 0;\n  }\n  .ts-header h1 {\n    font-size: 2rem;\n    font-weight: 300;\n    letter-spacing: -0.5px;\n    margin: 0 0 8px 0;\n  }\n  .ts-badge-row {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 8px;\n    margin-bottom: 6px;\n  }\n  .ts-live-badge {\n    background: rgba(0, 180, 216, 0.2);\n    border: 1px solid var(--accent-blue);\n    color: var(--accent-blue);\n    font-size: 0.65rem;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    padding: 2px 8px;\n    border-radius: 12px;\n    font-weight: 600;\n  }\n  .ts-date {\n    font-size: 0.75rem;\n    opacity: 0.6;\n  }\n  .ts-subtitle {\n    font-size: 0.9rem;\n    opacity: 0.7;\n    font-style: italic;\n    margin: 4px 0 0 0;\n  }\n\n  /* --- Sticky Elements Wrapper --- */\n  .ts-sticky-controls {\n    position: sticky;\n    top: 0;\n    z-index: 100;\n    background: var(--glass-sticky);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    padding: 12px 0 4px 0;\n    margin-bottom: 8px;\n    border-bottom: 1px solid var(--glass-border);\n  }\n\n  /* Search Styles */\n  .ts-search-wrapper {\n    margin-bottom: 12px;\n  }\n  .ts-search-input {\n    width: 100%;\n    background: var(--glass-white);\n    border: 1px solid var(--glass-border);\n    border-radius: 8px;\n    padding: 12px 16px;\n    color: var(--accent-white);\n    font-size: 0.95rem;\n    outline: none;\n    box-sizing: border-box;\n    transition: border-color 0.2s, background-color 0.2s;\n  }\n  .ts-search-input:focus {\n    border-color: var(--accent-blue);\n    background: rgba(255, 255, 255, 0.12);\n  }\n\n  /* Filter Styles */\n  .ts-filters-scroll {\n    display: flex;\n    gap: 8px;\n    overflow-x: auto;\n    padding-bottom: 8px;\n    scrollbar-width: none; /* Firefox */\n  }\n  .ts-filters-scroll::-webkit-scrollbar {\n    display: none; /* Safari/Chrome */\n  }\n  .ts-filter-btn {\n    background: var(--glass-white);\n    border: 1px solid var(--glass-border);\n    color: var(--accent-white);\n    padding: 8px 16px;\n    border-radius: 20px;\n    font-size: 0.85rem;\n    white-space: nowrap;\n    cursor: pointer;\n    transition: all 0.25s ease;\n    user-select: none;\n  }\n  .ts-filter-btn.active {\n    background: var(--accent-blue);\n    border-color: var(--accent-blue);\n    color: var(--bg-color);\n    font-weight: 600;\n  }\n\n  /* --- Dashboard List Glass Grid --- */\n  .ts-list-container {\n    background: var(--glass-white);\n    border: 1px solid var(--glass-border);\n    border-radius: 12px;\n    overflow: hidden;\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);\n    margin-bottom: 40px;\n  }\n\n  /* Table Architecture */\n  .ts-table {\n    width: 100%;\n    border-collapse: collapse;\n    text-align: left;\n  }\n  \n  .ts-thead {\n    position: sticky;\n    top: 108px; /* Accounts for search + filters dynamically */\n    z-index: 90;\n    background: #112947;\n    border-bottom: 1px solid var(--glass-border);\n  }\n  .ts-thead th {\n    padding: 12px 16px;\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    opacity: 0.5;\n    font-weight: 600;\n  }\n\n  /* Rows */\n  .ts-row {\n    border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n    cursor: pointer;\n    transition: background-color 0.2s, transform 0.15s;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .ts-row:last-child {\n    border-bottom: none;\n  }\n  .ts-row:hover {\n    background-color: rgba(255, 255, 255, 0.04);\n  }\n  .ts-row:active {\n    background-color: rgba(255, 255, 255, 0.08);\n  }\n\n  .ts-cell {\n    padding: 14px 16px;\n    vertical-align: middle;\n    font-size: 0.95rem;\n  }\n\n  /* Specific Column Styling */\n  .ts-cell-product {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-weight: 400;\n  }\n  .ts-status-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    flex-shrink: 0;\n    display: inline-block;\n  }\n  .ts-status-dot.in-stock { background-color: #4CAF50; box-shadow: 0 0 6px #4CAF50; }\n  .ts-status-dot.prebook { background-color: #F44336; box-shadow: 0 0 6px #F44336; }\n\n  .ts-cell-qty {\n    opacity: 0.7;\n    font-size: 0.85rem;\n  }\n  \n  .ts-cell-price {\n    color: var(--accent-gold);\n    font-weight: 600;\n    white-space: nowrap;\n  }\n\n  .ts-cell-action {\n    text-align: right;\n    width: 40px;\n  }\n  .ts-chevron {\n    color: var(--accent-blue);\n    font-size: 1.25rem;\n    display: inline-block;\n    transition: transform 0.2s ease;\n    line-height: 1;\n  }\n  .ts-row:hover .ts-chevron {\n    transform: scale(1.2) translateX(2px);\n    color: var(--accent-white);\n  }\n\n  /* No Data State */\n  .ts-no-results {\n    padding: 32px;\n    text-align: center;\n    opacity: 0.5;\n    font-style: italic;\n    display: none;\n  }\n\n  /* --- Desktop Enhancements --- */\n  @media (min-width: 768px) {\n    .ts-market-container {\n      padding: 40px 24px;\n    }\n    .ts-header h1 {\n      font-size: 2.75rem;\n    }\n    .ts-cell {\n      padding: 18px 24px;\n    }\n    .ts-thead th {\n      padding: 14px 24px;\n    }\n    .ts-sticky-controls {\n      padding: 20px 0 8px 0;\n    }\n    .ts-thead {\n      top: 126px; /* Adjusting alignment for desktop heights */\n    }\n  }\n</style>\n\n<div class=\"ts-market-body\">\n  \n  <div class=\"ts-ocean-bg\">\n    <div class=\"ts-bubble\"></div>\n    <div class=\"ts-bubble\"></div>\n    <div class=\"ts-bubble\"></div>\n    <div class=\"ts-fish-silhouette\"></div>\n    <div class=\"ts-fish-silhouette\"></div>\n  </div>\n  <div class=\"ts-crab\"></div>\n\n  <div class=\"ts-market-container\">\n    \n    <header class=\"ts-header\">\n      <div class=\"ts-badge-row\">\n        <span class=\"ts-live-badge\">Live Market</span>\n        <span class=\"ts-date\" id=\"current-date\"></span>\n      </div>\n      <h1>Today's Seafood Prices</h1>\n      <p class=\"ts-subtitle\">Fresh Catch. Fair Price.</p>\n    </header>\n\n    <div class=\"ts-sticky-controls\">\n      <div class=\"ts-search-wrapper\">\n        <input type=\"text\" id=\"ts-search\" class=\"ts-search-input\" placeholder=\"Search daily catch...\" autocomplete=\"off\">\n      </div>\n      <div class=\"ts-filters-scroll\">\n        <button class=\"ts-filter-btn active\" data-filter=\"all\">All</button>\n        <button class=\"ts-filter-btn\" data-filter=\"in-stock\">In Stock</button>\n        <button class=\"ts-filter-btn\" data-filter=\"prebook\">Prebook</button>\n        <button class=\"ts-filter-btn\" data-filter=\"price-low\">Price Low → High</button>\n        <button class=\"ts-filter-btn\" data-filter=\"price-high\">Price High → Low</button>\n      </div>\n    </div>\n\n    <div class=\"ts-list-container\">\n      <table class=\"ts-table\">\n        <thead class=\"ts-thead\">\n          <tr>\n            <th style=\"width: 50%;\">Product</th>\n            <th style=\"width: 25%;\">Qty</th>\n            <th style=\"width: 20%;\">Price</th>\n            <th style=\"width: 5%; text-align: right;\"></th>\n          </tr>\n        </thead>\n        <tbody id=\"ts-product-rows\">\n          {%- comment -%} Pulls live data straight out of the Shopify Collection engine {%- endcomment -%}\n          {% assign market_collection = collections[SEAFOOD_COLLECTION_HANDLE] %}\n          {% for product in market_collection.products %}\n            {% assign first_variant = product.variants.first %}\n            <tr class=\"ts-row\" \n                data-title=\"{{ product.title | escape | downcase }}\" \n                data-available=\"{% if product.available %}true{% else %}false{% endif %}\" \n                data-price=\"{{ first_variant.price }}\"\n                onclick=\"window.location.href='{{ SEE_MORE_URL }}';\">\n              \n              <td class=\"ts-cell ts-cell-product\">\n                {% if product.available %}\n                  <span class=\"ts-status-dot in-stock\"></span>\n                {% else %}\n                  <span class=\"ts-status-dot prebook\"></span>\n                {% endif %}\n                <span>{{ product.title }}</span>\n              </td>\n              \n              <td class=\"ts-cell ts-cell-qty\">\n                {{ first_variant.title }}\n              </td>\n              \n              <td class=\"ts-cell ts-cell-price\">\n                {{ first_variant.price | money }}\n              </td>\n              \n              <td class=\"ts-cell ts-cell-action\">\n                <span class=\"ts-chevron\">→</span>\n              </td>\n            </tr>\n          {% else %}\n            <tr>\n              <td colspan=\"4\" class=\"ts-cell\" style=\"text-align: center; opacity: 0.5; padding: 40px 0;\">\n                No seasonal allocations active at this moment.\n              </td>\n            </tr>\n          {% endfor %}\n        </tbody>\n      </table>\n      \n      <div id=\"ts-empty-state\" class=\"ts-no-results\">\n        No varieties match your selected filter criteria.\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    // Generate Current Human Readable Market Stamp\n    const dateOptions = { month: 'short', day: 'numeric', year: 'numeric' };\n    document.getElementById('current-date').innerText = new Date().toLocaleDateString('en-US', dateOptions);\n\n    // Dom Elements\n    const searchInput = document.getElementById('ts-search');\n    const filterButtons = document.querySelectorAll('.ts-filter-btn');\n    const tableRows = document.querySelectorAll('.ts-row');\n    const emptyState = document.getElementById('ts-empty-state');\n    const tableBody = document.getElementById('ts-product-rows');\n\n    // Dynamic State Values\n    let activeSearchTerm = \"\";\n    let activeFilterMode = \"all\"; // 'all', 'in-stock', 'prebook'\n    let activeSortMode = \"\";      // '', 'price-low', 'price-high'\n\n    // Process State Changes\n    function runLiveFilters() {\n      let visibleCount = 0;\n\n      tableRows.forEach(row => {\n        const title = row.getAttribute('data-title');\n        const available = row.getAttribute('data-available') === 'true';\n        \n        // Search Logic Check\n        const matchSearch = title.includes(activeSearchTerm);\n        \n        // Availability Logic Check\n        let matchFilter = false;\n        if (activeFilterMode === 'all') matchFilter = true;\n        else if (activeFilterMode === 'in-stock' && available) matchFilter = true;\n        else if (activeFilterMode === 'prebook' && !available) matchFilter = true;\n\n        if (matchSearch && matchFilter) {\n          row.style.display = \"\";\n          visibleCount++;\n        } else {\n          row.style.display = \"none\";\n        }\n      });\n\n      // Toggle Table Content Context Visibility State\n      emptyState.style.display = (visibleCount === 0) ? \"block\" : \"none\";\n    }\n\n    // High Performance Sorting Functionality\n    function sortPrices(order) {\n      const rowsArray = Array.from(tableRows);\n      \n      rowsArray.sort((rowA, rowB) => {\n        const priceA = parseFloat(rowA.getAttribute('data-price'));\n        const priceB = parseFloat(rowB.getAttribute('data-price'));\n        return order === 'price-low' ? priceA - priceB : priceB - priceA;\n      });\n\n      // Clear layout order, re-append sorted items instantly\n      rowsArray.forEach(row => tableBody.appendChild(row));\n    }\n\n    // Input Event Listener Matrix\n    searchInput.addEventListener('input', function(e) {\n      activeSearchTerm = e.target.value.toLowerCase().trim();\n      runLiveFilters();\n    });\n\n    filterButtons.forEach(btn => {\n      btn.addEventListener('click', function() {\n        // Toggle selected active state highlights\n        filterButtons.forEach(b => b.classList.remove('active'));\n        this.classList.add('active');\n\n        const targetFilter = this.getAttribute('data-filter');\n\n        if (targetFilter === 'price-low' || targetFilter === 'price-high') {\n          activeSortMode = targetFilter;\n          sortPrices(activeSortMode);\n        } else {\n          activeFilterMode = targetFilter;\n        }\n        \n        runLiveFilters();\n      });\n    });\n  });\n</script>",
        "color_scheme": "",
