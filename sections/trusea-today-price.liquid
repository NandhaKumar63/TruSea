{% comment %}
==========================================================================
  Section: Today's Seafood Prices
  Premium, minimal, iOS-Settings-style price list for a fresh seafood
  ecommerce brand. Pulls products dynamically from a merchant-selected
  Shopify collection. No hardcoded products, no cards, no tables.
==========================================================================
{% endcomment %}

{%- liquid
  assign tsp_collection = collections[section.settings.collection]
  assign tsp_title = section.settings.title | default: "Today's Seafood Prices"
  assign tsp_subtitle = section.settings.subtitle | default: "Fresh Catch. Fair Price."
  assign tsp_badge_text = section.settings.live_badge_text | default: "Live Market"
  assign tsp_see_more_url = section.settings.see_more_url
  assign tsp_animate = section.settings.enable_bg_animation
-%}

<section
  class="tsp"
  id="tsp-{{ section.id }}"
  data-tsp-root
  data-see-more-url="{{ tsp_see_more_url | default: '#' }}"
>

  {%- comment -%} ============ AMBIENT BACKGROUND (decorative, CSS-only) ============ {%- endcomment -%}
  {%- if tsp_animate -%}
    <div class="tsp-ambient" aria-hidden="true">
      <div class="tsp-ambient__rays"></div>

      <span class="tsp-bubble tsp-bubble--1"></span>
      <span class="tsp-bubble tsp-bubble--2"></span>
      <span class="tsp-bubble tsp-bubble--3"></span>
      <span class="tsp-bubble tsp-bubble--4"></span>
      <span class="tsp-bubble tsp-bubble--5"></span>

      <svg class="tsp-fish tsp-fish--1" viewBox="0 0 64 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 16C14 4 34 4 46 16C34 28 14 28 2 16Z" fill="currentColor"/>
        <path d="M46 16L60 6V26L46 16Z" fill="currentColor"/>
        <circle cx="14" cy="13" r="1.6" fill="#0E2541"/>
      </svg>

      <svg class="tsp-fish tsp-fish--2" viewBox="0 0 64 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 16C14 4 34 4 46 16C34 28 14 28 2 16Z" fill="currentColor"/>
        <path d="M46 16L60 6V26L46 16Z" fill="currentColor"/>
        <circle cx="14" cy="13" r="1.6" fill="#0E2541"/>
      </svg>

      <svg class="tsp-crab" viewBox="0 0 48 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="24" cy="16" rx="14" ry="9" fill="currentColor"/>
        <path d="M10 12L2 6M38 12L46 6M10 20L2 26M38 20L46 26" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <circle cx="18" cy="12" r="1.4" fill="#0E2541"/>
        <circle cx="30" cy="12" r="1.4" fill="#0E2541"/>
      </svg>
    </div>
  {%- endif -%}

  <div class="tsp-container">

    {%- comment -%} ============ HEADER ============ {%- endcomment -%}
    <header class="tsp-header">
      <div class="tsp-badge">
        <span class="tsp-badge__dot"></span>
        <span>{{ tsp_badge_text }}</span>
      </div>

      <h2 class="tsp-title">{{ tsp_title }}</h2>
      <p class="tsp-subtitle">{{ tsp_subtitle }}</p>

      <p class="tsp-updated">
        Last updated
        <time datetime="{{ 'now' | date: '%Y-%m-%d' }}">{{ 'now' | date: '%b %d, %Y' }}</time>
      </p>
    </header>

    {%- comment -%} ============ STICKY SEARCH + FILTERS ============ {%- endcomment -%}
    <div class="tsp-controls" data-tsp-controls>
      <div class="tsp-search">
        <svg class="tsp-search__icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6"/>
          <path d="M18 18L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <input
          type="text"
          class="tsp-search__input"
          data-tsp-search
          placeholder="Search fish, prawns, crab, squid..."
          aria-label="Search seafood"
          autocomplete="off"
        >
      </div>

      <div class="tsp-filters" data-tsp-filters role="group" aria-label="Filter and sort seafood">
        <button type="button" class="tsp-chip is-active" data-mode="all">All</button>
        <button type="button" class="tsp-chip" data-mode="instock">In Stock</button>
        <button type="button" class="tsp-chip" data-mode="prebook">Prebook</button>
        <button type="button" class="tsp-chip" data-mode="price-asc">Price Low → High</button>
        <button type="button" class="tsp-chip" data-mode="price-desc">Price High → Low</button>
      </div>
    </div>

    {%- comment -%} ============ PRODUCT ROWS ============ {%- endcomment -%}
    <div class="tsp-list" data-tsp-list>
      {%- if tsp_collection != blank and tsp_collection.products.size > 0 -%}
        {%- for product in tsp_collection.products -%}
          {%- assign tsp_variant = product.selected_or_first_available_variant -%}
          {%- if tsp_variant == blank -%}
            {%- assign tsp_variant = product.variants.first -%}
          {%- endif -%}
          {%- assign tsp_available = product.available -%}
          {%- assign tsp_variant_title = tsp_variant.title -%}
          {%- if tsp_variant_title == blank or tsp_variant_title == "Default Title" -%}
            {%- assign tsp_variant_title = "500g" -%}
          {%- endif -%}

          <a
            href="{{ tsp_see_more_url | default: '#' }}"
            class="tsp-row"
            data-tsp-row
            data-name="{{ product.title | escape | downcase }}"
            data-price="{{ tsp_variant.price | divided_by: 100.0 }}"
            data-status="{% if tsp_available %}instock{% else %}prebook{% endif %}"
          >
            <span
              class="tsp-row__dot {% if tsp_available %}is-available{% else %}is-unavailable{% endif %}"
              aria-hidden="true"
            ></span>

            <span class="tsp-row__info">
              <span class="tsp-row__name">{{ product.title }}</span>
              <span class="tsp-row__variant">{{ tsp_variant_title }}</span>
            </span>

            <span class="tsp-row__price">{{ tsp_variant.price | money_without_trailing_zeros }}</span>

            <svg class="tsp-row__chevron" viewBox="0 0 8 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endfor -%}
      {%- else -%}
        <div class="tsp-empty">
          <p>Select a collection in the theme editor to display today's prices.</p>
        </div>
      {%- endif -%}
    </div>

    <div class="tsp-no-results" data-tsp-no-results hidden>
      <p>No seafood matches your search.</p>
    </div>

  </div>
</section>

{{ 'todays-seafood-prices.css' | asset_url | stylesheet_tag }}
<script src="{{ 'todays-seafood-prices.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Today's Seafood Prices",
  "tag": "section",
  "class": "tsp-shopify-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products in this collection are listed with their price and availability."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Today's Seafood Prices"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Fresh Catch. Fair Price."
    },
    {
      "type": "text",
      "id": "live_badge_text",
      "label": "Live market badge text",
      "default": "Live Market"
    },
    {
      "type": "url",
      "id": "see_more_url",
      "label": "See more URL",
      "info": "Every row links to this URL, not the individual product page."
    },
    {
      "type": "checkbox",
      "id": "enable_bg_animation",
      "label": "Enable background animation",
      "default": true,
      "info": "Subtle ocean light, bubbles, fish and a crab. CSS-only, respects reduced motion."
    }
  ],
  "presets": [
    {
      "name": "Today's Seafood Prices"
    }
  ]
}
{% endschema %}
