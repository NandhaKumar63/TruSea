{%- comment -%}
  Section: Today's Seafood Prices
{%- endcomment -%}

<section class="tsp-section" id="tsp-section-{{ section.id }}">
  <div class="tsp-wrap">

    <div class="tsp-header">
      <h2 class="tsp-title">{{ section.settings.section_title | default: "Today's Seafood Prices" }}</h2>
      <p class="tsp-subtitle">{{ section.settings.section_subtitle | default: "Fresh Catch. Fair Price." }}</p>
      <p class="tsp-updated">Last Updated: <span id="tsp-date-{{ section.id }}"></span></p>
    </div>

    <div class="tsp-container">

      <div class="tsp-search-wrap">
        <input
          type="text"
          class="tsp-search"
          id="tsp-search-{{ section.id }}"
          placeholder="Search products instantly."
          autocomplete="off"
        >
      </div>

      <div class="tsp-filters" id="tsp-filters-{{ section.id }}">
        <div class="tsp-filter-left">
          <button type="button" class="tsp-filter-btn is-active" data-filter="all">All</button>
          <button type="button" class="tsp-filter-btn" data-filter="in-stock">In Stock</button>
          <button type="button" class="tsp-filter-btn" data-filter="prebook">Prebook</button>
        </div>
        <div class="tsp-sort-wrap">
          <button type="button" class="tsp-sort-btn" id="tsp-sort-btn-{{ section.id }}">
            Sort <span class="tsp-sort-caret">&#9662;</span>
          </button>
          <div class="tsp-sort-menu" id="tsp-sort-menu-{{ section.id }}" hidden>
            <button type="button" class="tsp-sort-option" data-sort="price-asc">Price Low &rarr; High</button>
            <button type="button" class="tsp-sort-option" data-sort="price-desc">Price High &rarr; Low</button>
          </div>
        </div>
      </div>

      <div class="tsp-list" id="tsp-list-{{ section.id }}">
        {%- if section.settings.collection != blank -%}
          {%- for product in section.settings.collection.products -%}
            {%- assign variant = product.variants.first -%}
            {%- assign is_available = true -%}
            {%- if variant.inventory_management != blank and variant.inventory_quantity <= 0 -%}
              {%- assign is_available = false -%}
            {%- endif -%}
            <a
              href="{{ section.settings.see_more_url | default: '#' }}"
              class="tsp-row"
              data-name="{{ product.title | escape }}"
              data-status="{% if is_available %}in-stock{% else %}prebook{% endif %}"
              data-price="{{ variant.price | divided_by: 100.0 }}"
            >
              <span class="tsp-row-main">
                <span class="tsp-dot {% if is_available %}tsp-dot-green{% else %}tsp-dot-red{% endif %}"></span>
                <span class="tsp-name">{{ product.title }}</span>
              </span>
              <span class="tsp-row-meta">
                <span class="tsp-qty">{{ variant.title }}</span>
                <span class="tsp-price">{{ variant.price | money_without_trailing_zeros }}</span>
                <span class="tsp-chevron">&rsaquo;</span>
              </span>
            </a>
          {%- endfor -%}
        {%- else -%}
          <p class="tsp-empty">Select a collection in the theme editor to display products.</p>
        {%- endif -%}
      </div>

      <p class="tsp-no-results" id="tsp-no-results-{{ section.id }}" hidden>No products found.</p>

    </div>
  </div>
</section>

<style>
  #tsp-section-{{ section.id }} {
    background-color: #0E2541;
    padding: 40px 16px;
  }

  #tsp-section-{{ section.id }} .tsp-wrap {
    max-width: 1200px;
    margin: 0 auto;
  }

  #tsp-section-{{ section.id }} .tsp-header {
    text-align: center;
    margin-bottom: 24px;
  }

  #tsp-section-{{ section.id }} .tsp-title {
    color: #ffffff;
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 6px;
  }

  #tsp-section-{{ section.id }} .tsp-subtitle {
    color: #cfd9e6;
    font-size: 14px;
    margin: 0 0 4px;
  }

  #tsp-section-{{ section.id }} .tsp-updated {
    color: #9fb1c7;
    font-size: 12px;
    margin: 0;
  }

  #tsp-section-{{ section.id }} .tsp-container {
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    padding: 16px;
  }

  #tsp-section-{{ section.id }} .tsp-search-wrap {
    margin-bottom: 12px;
  }

  #tsp-section-{{ section.id }} .tsp-search {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 16px;
    border: 1px solid #dcdcdc;
    border-radius: 24px;
    font-size: 14px;
    color: #000000;
    outline: none;
  }

  #tsp-section-{{ section.id }} .tsp-search:focus {
    border-color: #0E2541;
  }

  #tsp-section-{{ section.id }} .tsp-filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
    position: relative;
  }

  #tsp-section-{{ section.id }} .tsp-filter-left {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  #tsp-section-{{ section.id }} .tsp-filter-btn {
    border: 1px solid #dcdcdc;
    background-color: #ffffff;
    color: #000000;
    font-size: 12px;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
  }

  #tsp-section-{{ section.id }} .tsp-filter-btn.is-active,
  #tsp-section-{{ section.id }} button.tsp-filter-btn.is-active {
    background-color: #0E2541 !important;
    color: #ffffff !important;
    border-color: #0E2541 !important;
  }

  #tsp-section-{{ section.id }} .tsp-sort-wrap {
    position: relative;
    flex: 0 0 auto;
  }

  #tsp-section-{{ section.id }} .tsp-sort-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    border: 1px solid #dcdcdc;
    background-color: #ffffff;
    color: #000000;
    font-size: 12px;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
  }

  #tsp-section-{{ section.id }} .tsp-sort-caret {
    font-size: 10px;
  }

  #tsp-section-{{ section.id }} .tsp-sort-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background-color: #ffffff;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    overflow: hidden;
    z-index: 5;
    min-width: 170px;
  }

  #tsp-section-{{ section.id }} .tsp-sort-option {
    display: block;
    width: 100%;
    text-align: left;
    border: none;
    background-color: #ffffff;
    color: #000000;
    font-size: 12px;
    padding: 10px 14px;
    cursor: pointer;
  }

  #tsp-section-{{ section.id }} .tsp-sort-option:hover {
    background-color: #f4f6f8;
  }

  #tsp-section-{{ section.id }} .tsp-sort-option + .tsp-sort-option {
    border-top: 1px solid #eeeeee;
  }

  #tsp-section-{{ section.id }} .tsp-list {
    display: flex;
    flex-direction: column;
  }

  #tsp-section-{{ section.id }} .tsp-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 10px;
    padding: 12px 4px;
    border-bottom: 1px solid #eeeeee;
    text-decoration: none;
    color: #000000;
  }

  #tsp-section-{{ section.id }} .tsp-row:last-child {
    border-bottom: none;
  }

  #tsp-section-{{ section.id }} .tsp-row-main {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1 1 150px;
    min-width: 0;
  }

  #tsp-section-{{ section.id }} .tsp-row-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    margin-left: auto;
    padding-left: 17px;
  }

  #tsp-section-{{ section.id }} .tsp-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  #tsp-section-{{ section.id }} .tsp-dot-green {
    background-color: #2ecc71;
  }

  #tsp-section-{{ section.id }} .tsp-dot-red {
    background-color: #e74c3c;
  }

  #tsp-section-{{ section.id }} .tsp-name {
    font-size: 14px;
    font-weight: 600;
    white-space: normal;
    word-break: break-word;
    line-height: 1.3;
  }

  #tsp-section-{{ section.id }} .tsp-qty {
    font-size: 13px;
    color: #555555;
    flex: 0 0 auto;
    min-width: 45px;
    text-align: right;
  }

  #tsp-section-{{ section.id }} .tsp-price {
    font-size: 14px;
    font-weight: 700;
    color: #FF6B00;
    flex: 0 0 auto;
    min-width: 65px;
    text-align: right;
  }

  #tsp-section-{{ section.id }} .tsp-chevron {
    font-size: 18px;
    color: #999999;
    flex: 0 0 auto;
  }

  #tsp-section-{{ section.id }} .tsp-empty,
  #tsp-section-{{ section.id }} .tsp-no-results {
    text-align: center;
    color: #777777;
    font-size: 14px;
    padding: 20px 0;
    margin: 0;
  }

  @media (max-width: 480px) {
    #tsp-section-{{ section.id }} .tsp-title {
      font-size: 22px;
    }

    #tsp-section-{{ section.id }} .tsp-name {
      font-size: 13px;
    }

    #tsp-section-{{ section.id }} .tsp-qty,
    #tsp-section-{{ section.id }} .tsp-price {
      font-size: 12px;
    }

    #tsp-section-{{ section.id }} .tsp-row {
      padding: 10px 2px;
    }
  }
</style>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var dateEl = document.getElementById('tsp-date-' + sectionId);
    if (dateEl) {
      var d = new Date();
      var options = { day: '2-digit', month: 'short', year: 'numeric' };
      dateEl.textContent = d.toLocaleDateString('en-IN', options);
    }

    var searchInput = document.getElementById('tsp-search-' + sectionId);
    var filterWrap = document.getElementById('tsp-filters-' + sectionId);
    var listWrap = document.getElementById('tsp-list-' + sectionId);
    var noResults = document.getElementById('tsp-no-results-' + sectionId);
    var sortBtn = document.getElementById('tsp-sort-btn-' + sectionId);
    var sortMenu = document.getElementById('tsp-sort-menu-' + sectionId);

    if (!listWrap) return;

    var rows = Array.prototype.slice.call(listWrap.querySelectorAll('.tsp-row'));
    var currentStatusFilter = 'all';
    var currentSearch = '';

    function applyFilters() {
      var visibleCount = 0;
      rows.forEach(function (row) {
        var matchesStatus = currentStatusFilter === 'all' || row.getAttribute('data-status') === currentStatusFilter;
        var name = (row.getAttribute('data-name') || '').toLowerCase();
        var matchesSearch = currentSearch === '' || name.indexOf(currentSearch) !== -1;
        var show = matchesStatus && matchesSearch;
        row.hidden = !show;
        if (show) visibleCount++;
      });
      if (noResults) noResults.hidden = visibleCount !== 0;
    }

    function sortRowsInDom(sorted) {
      sorted.forEach(function (row) {
        listWrap.appendChild(row);
      });
      rows = sorted;
    }

    function sortByPrice(order) {
      var sorted = rows.slice().sort(function (a, b) {
        var pa = parseFloat(a.getAttribute('data-price')) || 0;
        var pb = parseFloat(b.getAttribute('data-price')) || 0;
        return order === 'price-asc' ? pa - pb : pb - pa;
      });
      sortRowsInDom(sorted);
    }

    function sortAlphabetically() {
      var sorted = rows.slice().sort(function (a, b) {
        var na = (a.getAttribute('data-name') || '').toLowerCase();
        var nb = (b.getAttribute('data-name') || '').toLowerCase();
        if (na < nb) return -1;
        if (na > nb) return 1;
        return 0;
      });
      sortRowsInDom(sorted);
    }

    function closeSortMenu() {
      if (sortMenu) sortMenu.hidden = true;
    }

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        currentSearch = this.value.trim().toLowerCase();
        applyFilters();
      });
    }

    if (filterWrap) {
      filterWrap.addEventListener('click', function (e) {
        var filterBtn = e.target.closest('.tsp-filter-btn');
        if (filterBtn && filterWrap.contains(filterBtn)) {
          var filter = filterBtn.getAttribute('data-filter');
          currentStatusFilter = filter;

          var filterButtons = filterWrap.querySelectorAll('.tsp-filter-btn[data-filter]');
          filterButtons.forEach(function (b) {
            b.classList.remove('is-active');
          });
          filterBtn.classList.add('is-active');

          if (filter === 'all') {
            sortAlphabetically();
          }
          applyFilters();
          return;
        }
      });
    }

    if (sortBtn && sortMenu) {
      sortBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        sortMenu.hidden = !sortMenu.hidden;
      });

      sortMenu.addEventListener('click', function (e) {
        var option = e.target.closest('.tsp-sort-option');
        if (!option) return;
        var sort = option.getAttribute('data-sort');
        if (sort) sortByPrice(sort);
        closeSortMenu();
      });

      document.addEventListener('click', function (e) {
        if (!sortMenu.hidden && !sortMenu.contains(e.target) && e.target !== sortBtn) {
          closeSortMenu();
        }
      });
    }

    sortAlphabetically();
  })();
</script>

{% schema %}
{
  "name": "Today's Seafood Prices",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "url",
      "id": "see_more_url",
      "label": "See More URL"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Today's Seafood Prices"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Fresh Catch. Fair Price."
    }
  ],
  "presets": [
    {
      "name": "Today's Seafood Prices"
    }
  ]
}
{% endschema %}
